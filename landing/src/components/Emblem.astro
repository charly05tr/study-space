---
import { Image } from 'astro:assets';
import romanForum from '../assets/images/roman-forum.jpg';
import porticoLion from '../assets/images/portico-lion.jpg';
---

<section class="marble-faint overflow-hidden py-24 md:py-32">
  <div class="mx-auto grid max-w-6xl items-center gap-16 px-6 lg:grid-cols-[1fr_1.1fr] lg:px-24">
    <div class="relative mx-auto h-120 w-full max-w-sm">
      <div data-reveal class="arch absolute top-0 left-0 w-3/5 overflow-hidden border border-gold/40 p-2">
        <Image
          src={romanForum}
          alt="A Roman forum at golden hour, with a colonnade and an amphitheater behind it"
          widths={[320, 640]}
          sizes="(min-width: 1024px) 230px, 60vw"
          class="arch aspect-[9/16] w-full object-cover"
        />
      </div>
      <div data-reveal data-reveal-delay="150" class="arch absolute right-0 bottom-0 w-1/2 overflow-hidden border border-gold/40 bg-vellum p-2">
        <Image
          src={porticoLion}
          alt="A bronze lion guarding a neoclassical portico with Corinthian columns"
          widths={[320, 640]}
          sizes="(min-width: 1024px) 192px, 50vw"
          class="arch aspect-[9/16] w-full object-cover"
        />
      </div>
    </div>

    <figure class="flex flex-col gap-8">
      <p data-reveal class="font-display text-xs tracking-[0.3em] text-gold-deep uppercase">The guardian of the palace</p>
      <blockquote data-reveal data-reveal-delay="100">
        <p class="font-display text-4xl font-medium text-engraved sm:text-5xl">
          “Imagination<br />rules the world.”
        </p>
      </blockquote>
      <figcaption data-reveal data-reveal-delay="200" class="flex flex-col gap-4">
        <span class="flex items-center gap-3 text-sm font-semibold tracking-wide text-ink">
          <span class="h-px w-8 bg-gold"></span>
          Attributed to Napoleon Bonaparte
        </span>
        <span class="max-w-[520px] text-base text-ink-soft">
          He carried a traveling library on campaign and read in the carriage between battles.
          His bust watches over Study Space as a reminder that the habit of reading outlasts any
          single victory.
        </span>
      </figcaption>
    </figure>
  </div>
</section>
