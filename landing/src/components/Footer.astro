---
import { Icon } from 'astro-icon/components';
import { DOWNLOAD_URL, REPO_URL } from '../config';

const links = [
  { href: DOWNLOAD_URL, label: 'Releases' },
  { href: REPO_URL, label: 'Source code' },
  { href: `${REPO_URL}/issues`, label: 'Report an issue' },
  { href: '/privacy', label: 'Privacy' },
];
---

<footer class="border border-gold/20 bg-night text-marble/70">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 md:flex-row md:items-center md:justify-between lg:px-24">
    <a href="/" class="flex items-center gap-3 text-marble">
      <img src="/favicon.png" alt="" width="40" height="40" class="size-10 rounded-full border border-gold/50" />
      <span class="flex flex-col">
        <span class="font-display text-base tracking-widest">Study Space</span>
        <span class="text-xs text-marble/50">A memory palace for everything you study</span>
      </span>
    </a>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors duration-700 ease-fluid hover:text-gold-bright">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      href={REPO_URL}
      aria-label="Study Space on GitHub"
      class="flex size-10 items-center justify-center rounded-full border border-gold/30 transition-colors duration-700 ease-fluid hover:border-gold hover:text-gold-bright"
    >
      <Icon name="ph:github-logo" class="size-5" aria-hidden="true" />
    </a>
  </div>
  <p class="border border-x-0 border-b-0 border-gold/10 py-6 text-center font-display text-xs tracking-[0.3em] text-marble/40">
    MMXXVI · STUDY SPACE
  </p>
</footer>
