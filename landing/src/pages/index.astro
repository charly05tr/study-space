---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Frieze from '../components/Frieze.astro';
import Problem from '../components/Problem.astro';
import Manifesto from '../components/Manifesto.astro';
import Rooms from '../components/Rooms.astro';
import Tagline from '../components/Tagline.astro';
import Emblem from '../components/Emblem.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Fragment slot="head">
    <link rel="preload" href="/models/napoleon.glb" as="fetch" type="model/gltf-binary" crossorigin />
  </Fragment>
  <Nav />
  <main id="main">
    <Hero />
    <Frieze />
    <Problem />
    <Manifesto />
    <Rooms />
    <Tagline />
    <Emblem />
    <FinalCta />
  </main>
  <Footer />
</Layout>
